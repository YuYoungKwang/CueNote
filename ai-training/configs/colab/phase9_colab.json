{
  "schemaVersion": 1,
  "runModes": ["SMOKE", "LAYOUT_TRAIN", "SYMBOL_TRAIN", "SYMBOL_OVERFIT", "SYMBOL_TILE_OVERFIT", "SYMBOL_TILE_TRAIN", "FULL_PIPELINE"],
  "defaultRunMode": "SMOKE",
  "driveRootEnv": "CUENOTE_DRIVE_ROOT",
  "defaultDriveRoot": "/content/drive/MyDrive/CueNote",
  "assumedDriveCapacityGb": 14,
  "minimumFreeDriveGbBeforeTraining": 3,
  "repoUrlEnv": "CUENOTE_REPO_URL",
  "defaultRepoUrl": "",
  "scratchRoot": "/content/cuenote-phase9",
  "paths": {
    "datasets": "datasets",
    "converted": "datasets/converted",
    "manifests": "datasets/manifests",
    "checkpoints": "checkpoints",
    "artifacts": "artifacts",
    "onnx": "artifacts/onnx",
    "reports": "reports",
    "logs": "logs",
    "raw": "raw",
    "cache": "cache",
    "runs": "runs"
  },
  "checkpointPolicy": {
    "saveEveryEpoch": false,
    "keepRecentCheckpointCount": 1,
    "atomicWrite": true,
    "resumeIfCompatible": true,
    "requireConfigChecksumMatch": true,
    "keepLast": true,
    "keepBest": true
  },
  "datasetPolicy": {
    "defaultDataset": "deepscoresv2-dense",
    "fallbackDataset": "cuenote-fixture-omr",
    "maxDenseImagesForSmoke": 24,
    "maxDenseImagesForColabSubset": 320,
    "maxDenseSourceGroupsForColabSubset": 40,
    "allowResearchOnlyTraining": false,
    "excludeUnverified": true,
    "sourceGroupSplitRequired": true
  },
  "overfitPolicy": {
    "sourceConvertedDataset": "deepscoresv2-dense-symbol",
    "convertedDataset": "deepscoresv2-dense-symbol-overfit",
    "trainImageCount": 2,
    "batchSize": 1,
    "inputSize": 1280,
    "epochs": 100,
    "earlyStoppingPatience": 0,
    "pretrained": true,
    "plots": false,
    "predictionConfidenceThresholds": [0.001, 0.01, 0.05],
    "maxConfidenceProbeThreshold": 0.00001,
    "minPassingTrainMap50": 0.5,
    "minPassingMaxConfidence": 0.05
  },
  "tileOverfitPolicy": {
    "sourceConvertedDataset": "deepscoresv2-dense-symbol",
    "convertedDataset": "deepscoresv2-dense-symbol-tile-overfit",
    "sourceTrainImageCount": 2,
    "cropSize": 768,
    "allowedCropSizes": [512, 768, 1024],
    "overlap": 0.25,
    "minCropCount": 10,
    "maxCropCount": 50,
    "minBoxPixels": 2,
    "keepEmptyCrops": false,
    "batchSize": 2,
    "inputSize": 768,
    "epochs": 100,
    "earlyStoppingPatience": 0,
    "pretrained": true,
    "plots": false,
    "predictionConfidenceThresholds": [0.001, 0.01, 0.05],
    "maxConfidenceProbeThreshold": 0.00001,
    "minPassingTrainMap50": 0.5,
    "minPassingMaxConfidence": 0.05
  },
  "tileTrainPolicy": {
    "sourceConvertedDataset": "deepscoresv2-dense-symbol",
    "convertedDataset": "deepscoresv2-dense-symbol-tile",
    "datasetId": "deepscoresv2-dense-symbol-tile",
    "cropSize": 768,
    "allowedCropSizes": [512, 768, 1024],
    "overlap": 0.25,
    "minBoxPixels": 2,
    "keepEmptyCrops": false,
    "batchSize": 4,
    "inputSize": 768,
    "epochs": 40,
    "earlyStoppingPatience": 5,
    "pretrained": true,
    "plots": false
  },
  "statusFile": "run-state.json",
  "artifactZipNamePattern": "cuenote-{modelId}-{version}-{status}.zip"
}
