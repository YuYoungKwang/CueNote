{
  "name": "cuenote-ai-training",
  "private": true,
  "type": "module",
  "scripts": {
    "build:fixture": "node scripts/build-fixture-dataset.mjs",
    "validate:dataset": "node scripts/validate-dataset.mjs",
    "train:layout": "node scripts/train-smoke-model.mjs --task LAYOUT_DETECTION",
    "train:symbol": "node scripts/train-smoke-model.mjs --task SYMBOL_DETECTION",
    "evaluate:layout": "node scripts/evaluate-smoke-model.mjs --task LAYOUT_DETECTION",
    "evaluate:symbol": "node scripts/evaluate-smoke-model.mjs --task SYMBOL_DETECTION",
    "export:layout": "node scripts/export-onnx.mjs --task LAYOUT_DETECTION",
    "export:symbol": "node scripts/export-onnx.mjs --task SYMBOL_DETECTION",
    "validate:onnx": "node scripts/validate-onnx.mjs",
    "record:browser": "node scripts/record-browser-validation.mjs",
    "validate:configs": "node scripts/validate-configs.mjs",
    "validate:phase9i": "node scripts/validate-phase9i-symbol-coverage.mjs",
    "validate:notebooks": "node scripts/validate-notebooks.mjs",
    "package:fixture-artifact": "node scripts/package-fixture-artifact.mjs --model layout",
    "validate:artifact": "node scripts/validate-model-artifact.mjs ai-training/artifacts/layout-smoke-artifact.zip",
    "smoke": "node scripts/run-smoke-pipeline.mjs"
  }
}
