{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuenote.local/schemas/omr-source-license.schema.json",
  "title": "CueNote OMR Source And License Record",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceId",
    "sourceGroupId",
    "sourceType",
    "sourceName",
    "license",
    "copyrightHolder",
    "allowedForTraining",
    "allowedForRedistribution",
    "allowedForDerivativeDataset",
    "attributionRequired",
    "collectedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "sourceGroupId": { "type": "string", "minLength": 1 },
    "sourceType": { "enum": ["SYNTHETIC", "SCAN", "PHOTO", "SCREENSHOT", "GENERATED_AUGMENTATION"] },
    "sourceName": { "type": "string", "minLength": 1 },
    "sourceUri": { "type": "string" },
    "license": { "type": "string", "minLength": 1 },
    "licenseUrl": { "type": "string" },
    "copyrightHolder": { "type": "string", "minLength": 1 },
    "allowedForTraining": { "type": "boolean" },
    "allowedForRedistribution": { "type": "boolean" },
    "allowedForDerivativeDataset": { "type": "boolean" },
    "attributionRequired": { "type": "boolean" },
    "collectedAt": { "type": "string" },
    "notes": { "type": "string" }
  }
}
