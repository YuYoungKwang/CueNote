{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuenote.local/schemas/omr-evaluation-report.schema.json",
  "title": "CueNote OMR Evaluation Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "modelId",
    "modelVersion",
    "modelStatus",
    "datasetId",
    "datasetVersion",
    "gitCommit",
    "evaluatedAt",
    "task",
    "split",
    "overallMetrics",
    "perClassMetrics",
    "perQualityMetrics",
    "confusionMatrix",
    "latency",
    "modelSize",
    "knownFailures",
    "promotionRecommendation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "modelId": { "type": "string" },
    "modelVersion": { "type": "string" },
    "modelStatus": { "enum": ["EXPERIMENTAL", "CANDIDATE", "PRODUCT"] },
    "datasetId": { "type": "string" },
    "datasetVersion": { "type": "string" },
    "gitCommit": { "type": "string" },
    "evaluatedAt": { "type": "string" },
    "task": { "enum": ["LAYOUT_DETECTION", "SYMBOL_DETECTION"] },
    "split": { "enum": ["validation", "test"] },
    "overallMetrics": { "$ref": "#/$defs/metrics" },
    "perClassMetrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["classId", "precision", "recall", "f1", "ap50", "support"],
        "properties": {
          "classId": { "type": "string" },
          "precision": { "type": "number", "minimum": 0, "maximum": 1 },
          "recall": { "type": "number", "minimum": 0, "maximum": 1 },
          "f1": { "type": "number", "minimum": 0, "maximum": 1 },
          "ap50": { "type": "number", "minimum": 0, "maximum": 1 },
          "support": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "perQualityMetrics": { "type": "object" },
    "confusionMatrix": { "type": "array" },
    "latency": {
      "type": "object",
      "required": ["nodeSmokeMs", "browserMedianMs"],
      "properties": {
        "nodeSmokeMs": { "type": "number", "minimum": 0 },
        "browserMedianMs": { "type": "number", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "modelSize": {
      "type": "object",
      "required": ["fp32Bytes", "fp16Bytes", "int8Bytes"],
      "properties": {
        "fp32Bytes": { "type": "integer", "minimum": 0 },
        "fp16Bytes": { "type": "integer", "minimum": 0 },
        "int8Bytes": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "browserCompatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["browser", "provider", "status"],
        "properties": {
          "browser": { "type": "string" },
          "provider": { "enum": ["WEBGPU", "WASM"] },
          "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
          "loadTimeMs": { "type": "number", "minimum": 0 },
          "medianInferenceMs": { "type": "number", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "knownFailures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "promotionRecommendation": { "enum": ["REJECT", "EXPERIMENTAL", "CANDIDATE", "PRODUCT"] }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "required": ["precision", "recall", "f1", "ap50", "meanIoU"],
      "properties": {
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "f1": { "type": "number", "minimum": 0, "maximum": 1 },
        "ap50": { "type": "number", "minimum": 0, "maximum": 1 },
        "meanIoU": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
