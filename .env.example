APP_VERSION=0.1.0
SERVER_PORT=8080

POSTGRES_DB=cuenote
POSTGRES_USER=cuenote
POSTGRES_PASSWORD=replace-with-local-dev-password
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cuenote
SPRING_DATASOURCE_USERNAME=cuenote
SPRING_DATASOURCE_PASSWORD=replace-with-local-dev-password

CUENOTE_MUSICXML_MAX_BYTES=2097152
CUENOTE_OBJECT_STORAGE_TYPE=local
CUENOTE_OBJECT_STORAGE_LOCAL_ROOT=target/object-storage
CUENOTE_MINIO_ENDPOINT=http://localhost:9000
CUENOTE_MINIO_ACCESS_KEY=cuenote
CUENOTE_MINIO_SECRET_KEY=replace-with-local-minio-password
CUENOTE_MINIO_BUCKET=cuenote-scores

MINIO_ROOT_USER=cuenote
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

K8S_BACKEND_IMAGE=ghcr.io/your-org/cuenote-backend:0.1.0
K8S_HOST=api.cuenote.local
